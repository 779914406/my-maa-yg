        "play_mode": {
            "type": "select",
            "label": "挂机模式",
            "description": "选择单人挑战或组队邀请",
            "default_case": "单人挑战",
            "cases": [
                {
                    "name": "单人挑战",
                    "label": "单人挑战",
                    "pipeline_override": {
                        "合宿_模式分支": {
                            "next": "合宿_单人开始"
                        }
                    }
                },
                {
                    "name": "组队邀请",
                    "label": "组队邀请",
                    "pipeline_override": {
                        "合宿_模式分支": {
                            "next": "合宿_点击主页邀请"
                        }
                    }
                }
            ]
        },
        "run_count": {
            "type": "input",
            "label": "刷取次数",
            "description": "设置总共刷多少次后自动停止",
            "inputs": [
                {
                    "name": "count",
                    "label": "次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "合宿_循环计数拦截": {
                    "custom_action_param": {
                        "count": "{count}"
                    }
                }
            }
        },
        "invite_friend": {
            "type": "input",
            "label": "邀请好友名字",
            "description": "输入要组队邀请的公会好友昵称",
