        "play_mode": {
            "type": "select",
            "label": "挂机模式",
            "description": "选择单人挑战或组队挑战",
            "default_case": "单人挑战",
            "cases": [
                {
                    "name": "单人挑战",
                    "label": "单人挑战",
                    "pipeline_override": {
                        "合宿_门票检查": {
                            "custom_action_param": {
                                "balance_roi": [
                                    592,
                                    114,
                                    113,
                                    43
                                ],
                                "cost_roi": [
                                    408,
                                    1140,
                                    51,
                                    42
                                ],
                                "success_next": [
                                    "合宿_单人开始"
                                ],
                                "fail_next": [
                                    "合宿_结束"
                                ]
                            }
                        }
                    }
                },
                {
                    "name": "组队挑战",
                    "option": [
                        "invite_friend"
                    ],
                    "label": "组队挑战",
                    "pipeline_override": {
                        "合宿_门票检查": {
                            "custom_action_param": {
                                "balance_roi": [
                                    592,
                                    114,
                                    113,
                                    43
                                ],
                                "cost_roi": [
                                    408,
                                    1140,
                                    51,
                                    42
                                ],
                                "success_next": [
                                    "合宿_点击主页邀请"
                                ],
                                "fail_next": [
                                    "合宿_结束"
                                ]
                            }
                        }
                    }
                }
            ]
        },
        "run_count": {
            "type": "input",
            "inputs": [
                {
                    "name": "count",
                    "label": "刷取次数",
                    "description": "设置总共刷多少次后自动停止",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "合宿_循环计数拦截": {
                    "custom_action_param": {
                        "count": "{count}"
                    }
                }
            }
        },
        "hesu_run_mode": {
            "type": "select",
            "label": "合宿模式",
            "description": "选择固定次数刷取，或无限刷取直到没有合宿票为止",
            "default_case": "指定次数",
            "cases": [
                {
                    "name": "指定次数",
                    "label": "指定次数",
                    "option": [
                        "run_count"
                    ]
                },
                {
                    "name": "无限刷取",
                    "label": "无限刷取(直到票不够自动停止)",
                    "pipeline_override": {
                        "合宿_循环计数拦截": {
                            "custom_action_param": {
                                "count": -1
                            }
                        }
                    }
                }
            ]
        },
        "invite_friend": {
            "type": "input",
            "inputs": [
                {
                    "name": "好友名字",
                    "label": "邀请好友昵称",
                    "description": "输入要组队邀请的公会好友昵称,只会邀请公会的",
                    "default": "忆梦",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "合宿_查找忆梦并邀请": {
                    "expected": "{好友名字}"
                },
                "确认是否进来": {
                    "expected": "{好友名字}"
                }
            }
        },
        "accept_invite_friend": {
            "type": "input",
            "inputs": [
                {
                    "name": "同意好友名字",
                    "label": "接受好友邀请",
                    "description": "输入只同意其邀请的好友昵称（非该好友将拒绝）",
                    "default": "森祈雪",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "主线_检查邀请_第一条": {
                    "expected": "{同意好友名字}"
                },
                "主线_检查邀请_第二条": {
                    "expected": "{同意好友名字}"
                },
                "主线_检查邀请_第三条": {
                    "expected": "{同意好友名字}"
                },
                "同意邀请": {
                    "expected": "{同意好友名字}"
                }
            }
        },
