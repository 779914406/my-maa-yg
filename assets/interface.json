        "wujian_run_count": {
            "type": "input",
            "inputs": [
                {
                    "name": "count",
                    "label": "无间刷取次数",
                    "description": "设置无间鬼蜮总共刷多少次后自动停止",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "无间_循环计数拦截": {
                    "custom_action_param": {
                        "count": "{count}"
                    }
                }
            }
        },
        "hesu_invite_target": {
            "type": "select",
            "label": "合宿邀请对象",
            "description": "组队邀请时选择公会成员还是好友",
            "default_case": "公会",
            "cases": [
                {
                    "name": "公会",
                    "label": "公会",
                    "pipeline_override": {
                        "合宿_点击公会标签": {
                            "enabled": true
                        },
                        "合宿_点击好友标签": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "好友",
                    "label": "好友",
                    "pipeline_override": {
                        "合宿_点击公会标签": {
                            "enabled": false
                        },
                        "合宿_点击好友标签": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "hesu_mode": {
            "type": "select",
            "label": "合宿功能",
            "description": "选择正常刷合宿，或只领取合宿票后直接回主线",
            "default_case": "合宿挂机",
            "cases": [
                {
                    "name": "合宿挂机",
                    "label": "合宿挂机",
                    "option": [
                        "target_night",
                        "hesu_run_mode",
                        "play_mode",
                        "hesu_invite_target"
                    ],
                    "pipeline_override": {
                        "合宿正常打_启动": {
                            "enabled": true
                        },
                        "合宿领票_启动": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "只领票",
                    "label": "只领取合宿票",
                    "pipeline_override": {
                        "合宿正常打_启动": {
                            "enabled": false
                        },
                        "合宿领票_启动": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "wujian_mode": {
            "type": "select",
            "label": "无间刷取模式",
            "description": "选择固定次数刷取，或无限刷取直到副本主页显示“开启玩法”",
            "default_case": "指定次数",
            "cases": [
                {
                    "name": "指定次数",
                    "label": "指定次数",
                    "option": [
                        "wujian_run_count"
                    ]
                },
                {
                    "name": "无限刷取",
