{
    "interface_version": 2,
    "version": "1.0.2",
    "name": "妖怪金手指助手",
    "description": "日常清理",
    "contact": "QQ群: 123456789",
    "github": "https://github.com/779914406/my-maa-yg",
    "license": "MIT",
    "welcome": "欢迎使用妖怪金手指助手！",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": ".*",
                "window_regex": "妖怪金手指",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "-u",
            "./agent/main.py"
        ]
    },
