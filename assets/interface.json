                    "name": "好友名字",
                    "label": "好友昵称",
                    "default": "忆梦",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "合宿_查找忆梦并邀请": {
                    "expected": "{好友名字}"
                },
                "确认是否进来": {
                    "expected": "{好友名字}"
                }
            }
        },
        "accept_invite_friend": {
            "type": "input",
            "label": "接受邀请好友",
